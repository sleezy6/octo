## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Fichiers et dossiers à ignorer pour un projet .NET
bin/
# Cargo binaries (crates/*/src/bin) are source, not .NET output.
!crates/*/src/bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.vs/
# Rider
.idea/
# Visual Studio Code
.vscode/
# Autres fichiers temporaires
*.log

/.env
# A server's own compose additions, so the folder stays a clean clone the update helper can move.
/docker-compose.override.yml

# Downloaded music files
octo/downloads/

# local build artifacts
*.tgz

# Local runtime state
octo-config/
slskd-state/
navidrome-data/
# The compose default for DOWNLOAD_PATH, so a default install creates it here.
/downloads/

# Python bytecode + pytest state from the shim's tests
__pycache__/
*.py[cod]
.pytest_cache/

# Rust build output. Each worktree keeps its own target/; never share one CARGO_TARGET_DIR.
/target/

# GeoNames' files for the image build, when downloaded beforehand (docker.yml does).
/places-data/

# Parity harness runs: the writable library copies and the box reports.
parity/.run/
/octo-cache/

# Markdown notes, plans and reports stay local. Published: the READMEs, the Family
# guide the README links to, the icon attribution, and known-diffs.md, which
# parity.py reads.
*.md
!README.md
!docs/family.md
!docs/rust-migration/known-diffs.md
!scripts/admin-icons/SOURCES.md
