{
  "group": "library-edits",
  "description": "Library edits from the apps (octoLibraryActions v3): libraryAction retag, joinAlbum, cover, lookup, undo, restore and remove (to the trash, with the song's .lrc, and copy=true for a second copy), getLibraryActions for an admin and a listener, getLibraryTrash, and the dashboard's /api/admin/trash, /api/admin/trash/restore, /api/admin/library-actions and allow-download. Records the off answers first, then turns library actions on by a settings patch (dry run, then real), changes fixture songs, checks the files with exec (ffprobe tag dumps, folder and trash listings, the trash note, the state files), waits for Navidrome after each change, puts every song back as it was, and turns library actions off again. Every libraryAction answer is JSON whatever f says.",
  "defaults": {"auth": "p", "f": "json", "session": "admin", "backlog": "F"},
  "requests": [
    {"name": "trash-off", "path": "/rest/getLibraryTrash"},
    {"name": "trash-off-view-xml", "path": "/rest/getLibraryTrash.view", "f": null},
    {"name": "trash-badpass", "path": "/rest/getLibraryTrash", "auth": "bad"},
    {"name": "trash-apikey", "path": "/rest/getLibraryTrash", "auth": "apikey"},
    {"name": "retag-off", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "retag"], ["genre", "Ambient"]]},
    {"name": "lookup-off", "path": "/rest/libraryAction", "query": [["id", "{{song_flac2}}"], ["action", "lookup"]]},
    {"name": "restore-off", "path": "/rest/libraryAction", "query": [["id", "{{song_flac1}}"], ["action", "restore"]]},
    {"name": "admin-trash-off", "path": "/api/admin/trash", "auth": "none", "f": null},
    {"name": "admin-trash-restore-off", "method": "POST", "path": "/api/admin/trash/restore", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"id": "{{song_flac1}}"}}},
    {"name": "admin-trash-signed-out", "path": "/api/admin/trash", "auth": "none", "f": null, "session": null},
    {"name": "admin-trash-recovery", "path": "/api/admin/trash", "auth": "none", "f": null, "session": "recovery"},
    {"name": "admin-actions-off", "path": "/api/admin/library-actions", "auth": "none", "f": null},
    {"name": "admin-actions-recovery", "path": "/api/admin/library-actions", "auth": "none", "f": null, "session": "recovery"},
    {"name": "admin-actions-signed-out", "path": "/api/admin/library-actions", "auth": "none", "f": null, "session": null},
    {"name": "allow-download-off-bad-key", "method": "POST", "path": "/api/admin/library-actions/allow-download", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"key": "Delete|nope|1:1"}}},
    {"name": "settings-enable-dryrun", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LibraryActions": {"Enabled": true, "DryRun": true, "AllowedUsers": ["admin"], "Actions": [{"Action": "Delete", "Enabled": true}]}}}, "ignoreKeys": ["persisted"]},
    {"name": "wait-enabled", "path": "/rest/getLibraryActions", "until": {"from": "json:subsonic-response.libraryActions.enabled", "in": [true]}, "pollMs": 300, "timeoutMs": 20000},
    {"name": "actions-admin-view-xml", "path": "/rest/getLibraryActions.view", "f": null},
    {"name": "actions-admin-token", "path": "/rest/getLibraryActions", "auth": "t"},
    {"name": "actions-listener", "path": "/rest/getLibraryActions", "auth": "listener"},
    {"name": "actions-badpass", "path": "/rest/getLibraryActions", "auth": "bad"},
    {"name": "actions-post-form", "method": "POST", "path": "/rest/getLibraryActions", "auth": "none", "f": null, "body": {"form": [["u", "{{admin_user}}"], ["p", "{{admin_pass}}"], ["v", "1.16.1"], ["c", "parity"], ["f", "json"]]}},
    {"name": "extensions-on-json", "path": "/rest/getOpenSubsonicExtensions", "auth": "none"},
    {"name": "extensions-on-xml", "path": "/rest/getOpenSubsonicExtensions", "auth": "none", "f": null},
    {"name": "remove-dryrun", "path": "/rest/libraryAction", "query": [["id", "{{song_flac2}}"], ["action", "remove"]]},
    {"name": "retag-dryrun", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "retag"], ["genre", "Ambient"]]},
    {"name": "join-dryrun", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_3}}"], ["action", "joinAlbum"], ["like", "{{song_flac2}}"]]},
    {"name": "cover-dryrun", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_2}}"], ["action", "cover"]]},
    {"name": "undo-dryrun-nothing", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "undo"]]},
    {"name": "restore-dryrun-not-trashed", "path": "/rest/libraryAction", "query": [["id", "{{song_flac1}}"], ["action", "restore"]]},
    {"name": "upgrade-not-on", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "upgrade"]]},
