    {"name": "lookup-listener-not-allowed", "path": "/rest/libraryAction", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["action", "lookup"]]},
    {"name": "trash-listener-not-allowed", "path": "/rest/getLibraryTrash", "auth": "listener"},
    {"name": "retag-apikey", "path": "/rest/libraryAction", "auth": "apikey", "query": [["id", "{{song_mp3_1}}"], ["action", "retag"], ["genre", "Ambient"]]},
    {"name": "settings-allow-listener", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LibraryActions": {"AllowedUsers": ["admin", "listener"]}}}, "ignoreKeys": ["persisted"]},
    {"name": "wait-listener-allowed", "path": "/rest/getLibraryActions", "auth": "listener", "until": {"from": "json:subsonic-response.libraryActions.allowed", "in": [true]}, "pollMs": 300, "timeoutMs": 20000},
    {"name": "retag-listener-not-admin", "path": "/rest/libraryAction", "auth": "listener", "query": [["id", "{{song_mp3_1}}"], ["action", "retag"], ["genre", "Ambient"]]},
    {"name": "remove-listener-allowed", "path": "/rest/libraryAction", "auth": "listener", "query": [["id", "{{song_flac2}}"], ["action", "remove"]]},
