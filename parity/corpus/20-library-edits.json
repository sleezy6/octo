    {"name": "settings-admin-only", "method": "POST", "path": "/api/admin/settings", "auth": "none", "f": null, "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LibraryActions": {"AllowedUsers": ["admin"]}}}, "ignoreKeys": ["persisted"]},
