    {"name": "action-missing-params", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"]]},
    {"name": "action-unknown", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "rename"]]},
    {"name": "retag-no-fields", "path": "/rest/libraryAction", "query": [["id", "{{song_mp3_1}}"], ["action", "retag"], ["mood", "calm"]]},
